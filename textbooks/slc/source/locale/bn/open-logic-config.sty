% The source spells out Bengali determiners where the sentence calls for them.
% Keep the English article flags in source without inserting a determiner or space.
% Babel activates ! for !!; xparse's argument specification needs a literal !.
\chardef\OLBengaliBangCatcode=\catcode`\!
\catcode`\!=12\relax
\expandafter\RenewDocumentCommand\csname @printtoken\endcsname { t^ ta m !ts }{%
  \IfBooleanTF{#1}
    {\IfBooleanTF{#4}{\printtoken{P}{#3}}{\printtoken{S}{#3}}}
    {\IfBooleanTF{#4}{\printtoken{p}{#3}}{\printtoken{s}{#3}}}}
\catcode`\!=\OLBengaliBangCatcode\relax
\let\OLBengaliBangCatcode\relax
\renewcommand*{\article}[1]{}
\renewcommand*{\Article}[1]{}

\DeclareDocumentMacro \TAss {\text{অনুমান}}

\RenewDocumentCommand \indcase { s t{!} m m +m }{%
  \DeclareDocumentMacro \indfrm {#3}%
  \DeclareDocumentMacro \indfrmp {#3}%
  \DeclareDocumentMacro \indcomplex {#4}%
  \IfBooleanTF{#1}
    {$#3$ পরমাণু: }{$#3 \ident #4$: }%
  \IfBooleanTF{#2}{অনুশীলনী।}{#5}}

