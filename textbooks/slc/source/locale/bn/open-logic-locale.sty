% License, title-page credits and publication information.
\renewcommand*{\ollicensetext}[3]{%
  #2-এর \textit{#1} গ্রন্থটি #3-এর অধীনে প্রকাশিত।}
\renewcommand*{\olshortlicensetext}[1]{%
  #1-এর \textit{\href{\OLTlinkname}{\jobname}} \ifgitinfo{} /
  \href{https://creativecommons.org/licenses/by/4.0/}{CC BY 4.0}।}
\renewcommand*{\oluselicensetext}{%
  এটি \href{https://openlogicproject.org/}{\OLPname}-এর
  \textit{\href{\OLTlinkname}{\OLTname}} অবলম্বনে রচিত।
  মূল পাঠটি \href{https://creativecommons.org/licenses/by/4.0/}{\licensename}-এর
  শর্তে ব্যবহৃত হয়েছে।}
\renewcommand*{\olshortuselicensetext}[2]{%
  #2-এর \textit{#1}, \href{https://openlogicproject.org/}{\OLPname} অবলম্বনে /
  \href{https://creativecommons.org/licenses/by/4.0/}{CC BY 4.0}।}

